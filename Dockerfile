# syntax=docker/dockerfile:1
#
# Three stages. Only `runner` is the live image; `builder` is also pushed as the
# `migrate` image, because it still has the Prisma CLI (see k8s/migration-job.yaml).
#
# Node 24 to match local dev. It ships npm 11, which honours `allowScripts` in
# package.json (prisma's install scripts run, esbuild's is denied).

# ---------------------------------------------------------------------------
# deps: install exactly what package-lock.json pins.
# `postinstall` runs `prisma generate`, which needs the schema and config, and
# the config reads DIRECT_URL, so a placeholder is set. Nothing connects here.
# ---------------------------------------------------------------------------
FROM node:24-alpine AS deps
WORKDIR /app
ENV DIRECT_URL="postgresql://build:build@localhost:5432/build"
COPY package.json package-lock.json prisma.config.ts ./
COPY prisma ./prisma
RUN npm ci

# ---------------------------------------------------------------------------
# builder: generate the Prisma client into src/generated, then `next build`.
# Placeholder URLs only; real values come from the k8s Secret at runtime and
# are never baked into an image.
# ---------------------------------------------------------------------------
FROM node:24-alpine AS builder
WORKDIR /app
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build" \
    DIRECT_URL="postgresql://build:build@localhost:5432/build" \
    NEXT_TELEMETRY_DISABLED=1
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npx prisma generate && npm run build

# ---------------------------------------------------------------------------
# runner: the standalone server only. No source, no dev tools, no Prisma CLI.
# Prisma 7 with the pg driver adapter has no engine binary to copy: the
# generated client is bundled from src/generated by `next build`.
# ---------------------------------------------------------------------------
FROM node:24-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
