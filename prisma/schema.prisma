// Connection URLs live in prisma.config.ts (migrations) and src/lib/db.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionType {
  MEMBER
  MENTOR
  PARTNER
}

enum SubmissionStatus {
  NEW
  CONTACTED
  CLOSED
}

// Register-interest form entries. Fields are deliberately minimal (Children's
// Code / data minimisation) — PROPOSED, to be confirmed in the forms stage.
model Submission {
  id           String           @id @default(cuid())
  type         SubmissionType
  status       SubmissionStatus @default(NEW)
  firstName    String
  email        String
  ageRange     String? // members only
  organisation String? // partners only
  message      String?
  consentAt    DateTime // when they agreed to the privacy notice
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([type, status])
  @@index([createdAt]) // retention clean-up
}
