// Connection URLs live in prisma.config.ts (migrations) and src/lib/db.ts (app).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SubmissionType {
  MEMBER
  MENTOR
  PARTNER
}

enum SubmissionStatus {
  NEW
  CONTACTED
  ACCEPTED // became a member/mentor/partner — exempt from the 12-month clean-up
  CLOSED
}

enum PartnerInterest {
  SPONSOR
  HOST
  FUND
  OTHER
}

// Register-interest form entries. Fields agreed with the owner (docs/LOG.md,
// "Decisions for the forms stage") — keep them minimal: members can be 16–17.
model Submission {
  id              String           @id @default(cuid())
  type            SubmissionType
  status          SubmissionStatus @default(NEW)
  firstName       String
  email           String
  phone           String?
  ageRange        String? // members: "16-17" | "18-25"
  howHeard        String? // members
  role            String? // mentors: job / role
  linkedin        String? // mentors
  organisation    String? // partners
  interest        PartnerInterest? // partners
  message         String?
  consentAt       DateTime // when they agreed to the privacy notice
  lastContactedAt DateTime? // retention: deleted 12 months after this (or createdAt)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([type, status])
  @@index([createdAt]) // retention clean-up
}
