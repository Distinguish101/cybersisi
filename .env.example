# Copy to .env and adjust. Never commit .env.
#
# Local (docker compose): both URLs are the same.
# Neon: DATABASE_URL = pooled URL (…-pooler…), DIRECT_URL = direct URL (used by migrations),
#       both with ?sslmode=require (add &connect_timeout=15 for cold starts).
DATABASE_URL="postgresql://cybersis:cybersis@localhost:5432/cybersis"
DIRECT_URL="postgresql://cybersis:cybersis@localhost:5432/cybersis"

# Who receives new-submission alerts, and the first admin's login email
NOTIFY_EMAIL="you@example.com"
ADMIN_EMAIL="you@example.com"
# Resend (leave empty locally to skip sending emails)
RESEND_API_KEY=""
